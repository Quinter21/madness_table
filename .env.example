# Copia este fichero a .env (que está en el .gitignore) y pon valores reales.
# Nunca subas el .env con valores reales.

# Secreto para firmar los JWT: mínimo 32 caracteres, aleatorio.
# Generar uno:  openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# Base de datos (solo hace falta fuera del entorno de desarrollo local)
DB_URL=jdbc:postgresql://localhost:5432/madness
DB_USER=madness
DB_PASSWORD=cambia-esto